{
	"name": "llooma",
	"version": "0.33.0",
	"private": true,
	"homepage": "https://github.com/cedhuf/llooma",
	"description": "A minimal LLM chat app that runs entirely in your browser",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "concurrently \"typesafe-i18n\" \"vite dev --host\"",
		"dev:mobile": "HTTPS=1 concurrently \"typesafe-i18n\" \"vite dev --host\"",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"test": "playwright test --trace on --ignore-snapshots ",
		"screenshots": "SCREENSHOTS=1 playwright test tests/screenshots.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typesafe-i18n": "typesafe-i18n",
		"i18n:status": "node scripts/i18n-status.mjs",
		"check:api": "node scripts/check-api-docs.mjs",
		"personas:index": "node scripts/build-persona-index.mjs",
		"personas:check": "node scripts/build-persona-index.mjs --check",
		"playbooks:index": "node scripts/build-playbook-index.mjs",
		"playbooks:check": "node scripts/build-playbook-index.mjs --check",
		"seed:dev": "node scripts/seed-dev.mjs",
		"docs:dev": "pnpm --dir docs run dev",
		"docs:build": "pnpm --dir docs run build"
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@semantic-release/commit-analyzer": "^11.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^9.2.6",
		"@semantic-release/npm": "^11.0.3",
		"@semantic-release/release-notes-generator": "^12.1.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^25.9.9",
		"@types/semver": "^7.8.0",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"bits-ui": "^2.20.2",
		"codemirror": "^6.0.2",
		"concurrently": "^10.0.6",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"highlight.js": "^11.12.0",
		"katex": "^0.17.0",
		"markdown-it": "^14.3.3",
		"markdown-it-texmath": "^1.0.0",
		"ollama": "^0.5.18",
		"openai": "^4.104.0",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^23.1.1",
		"semver": "^7.8.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwindcss": "^4.3.3",
		"thememirror": "^2.0.1",
		"tslib": "^2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^6.4.5",
		"yaml": "^2.9.1"
	},
	"type": "module",
	"author": {
		"name": "Fernando Maclen",
		"email": "hello@fernando.is",
		"url": "https://fernando.is"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.3",
		"@firecrawl/anydoc-wasm": "0.2.4",
		"@khmyznikov/pwa-install": "^0.6.4",
		"@modelcontextprotocol/client": "^2.4.0",
		"client-zip": "^2.5.1",
		"ws": "^8.22.0"
	}
}
