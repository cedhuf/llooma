---
/**
 * What Llooma is built on.
 *
 * One list, edited here. Anything that does real work in the app belongs in it,
 * with the licence it is used under and a line saying what it actually does:
 * a credit nobody can read past is not a credit.
 *
 * `licence` is omitted where the entry is a service rather than a dependency.
 */
interface Credit {
	name: string;
	role: string;
	href: string;
	licence?: string;
}

const credits: Credit[] = [
	{
		name: 'Hollama',
		role: 'The project Llooma is a fork of, by fmaclen',
		href: 'https://github.com/fmaclen/hollama',
		licence: 'MIT'
	},
	{
		name: 'anydoc',
		role: 'Reads PDF, Word, PowerPoint and spreadsheets, in your browser',
		href: 'https://github.com/firecrawl/anydoc',
		licence: 'MIT'
	},
	{
		name: 'Svelte and SvelteKit',
		role: 'The app itself',
		href: 'https://svelte.dev',
		licence: 'MIT'
	},
	{
		name: 'Tailwind CSS',
		role: 'Every style in the interface',
		href: 'https://tailwindcss.com',
		licence: 'MIT'
	},
	{
		name: 'Bits UI',
		role: 'Menus, dialogs and popovers that behave on a keyboard',
		href: 'https://bits-ui.com',
		licence: 'MIT'
	},
	{
		name: 'Auth.js',
		role: 'Accounts, password sign-in and single sign-on',
		href: 'https://authjs.dev',
		licence: 'ISC'
	},
	{
		name: 'Lucide',
		role: 'The icons',
		href: 'https://lucide.dev',
		licence: 'ISC'
	},
	{
		name: 'KaTeX',
		role: 'Maths, rendered in a reply',
		href: 'https://katex.org',
		licence: 'MIT'
	},
	{
		name: 'markdown-it',
		role: 'Turns a reply into formatted text',
		href: 'https://github.com/markdown-it/markdown-it',
		licence: 'MIT'
	},
	{
		name: 'highlight.js',
		role: 'Colours the code in a reply',
		href: 'https://highlightjs.org',
		licence: 'BSD-3-Clause'
	},
	{
		name: 'CodeMirror',
		role: 'The editor for instructions and personas',
		href: 'https://codemirror.net',
		licence: 'MIT'
	},
	{
		name: 'Ollama',
		role: 'Models running on your own machine',
		href: 'https://ollama.com',
		licence: 'MIT'
	},
	{
		name: 'OpenAI SDK',
		role: 'Talks to every OpenAI-compatible provider',
		href: 'https://github.com/openai/openai-node',
		licence: 'Apache-2.0'
	},
	{
		name: 'MCP TypeScript SDK',
		role: 'Tools from Model Context Protocol servers',
		href: 'https://github.com/modelcontextprotocol/typescript-sdk',
		licence: 'Apache-2.0'
	},
	{
		name: 'Chatto',
		role: 'Where bots answer: a self-hosted team chat they join and reply in',
		href: 'https://github.com/chattocorp/chatto',
		licence: 'AGPL-3.0'
	},
	{
		name: 'degoog',
		role: 'The default web search backend, self-hosted like everything else here',
		href: 'https://github.com/degoog-org/degoog',
		licence: 'AGPL-3.0'
	},
	{
		name: 'typesafe-i18n',
		role: 'The interface in English and French',
		href: 'https://github.com/ivanhofer/typesafe-i18n',
		licence: 'MIT'
	},
	{
		name: 'svelte-sonner',
		role: 'The notifications',
		href: 'https://github.com/wobsoriano/svelte-sonner',
		licence: 'MIT'
	},
	{
		name: 'client-zip',
		role: 'Exports a backup as one zip, in your browser',
		href: 'https://github.com/Touffy/client-zip',
		licence: 'MIT'
	},
	{
		name: 'pwa-install',
		role: 'The prompt to install Llooma as an app',
		href: 'https://github.com/khmyznikov/pwa-install',
		licence: 'MIT'
	},
	{
		name: 'Inter, Source Serif 4 and JetBrains Mono',
		role: 'The type: interface, answers and code',
		href: 'https://rsms.me/inter/',
		licence: 'OFL-1.1'
	},
	{
		name: 'Starlight',
		role: 'This documentation site',
		href: 'https://starlight.astro.build',
		licence: 'MIT'
	}
];
---

<ul class="credits" role="list">
	{
		credits.map((credit) => (
			<li class="credit">
				<a class="credit__link" href={credit.href}>
					<span class="credit__name">{credit.name}</span>
					{credit.licence && <span class="credit__licence">{credit.licence}</span>}
				</a>
				<p class="credit__role">{credit.role}</p>
			</li>
		))
	}
</ul>
